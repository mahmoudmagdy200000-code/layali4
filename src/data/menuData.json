  "restaurantInfo": {
    "name": {
      "ar": "ليالي البترون",
      "en": "Layali Al Batroun"
    },
    "tagline": {
      "ar": "حيث تبدأ الحكاية",
      "en": "Where the story begins"
    },
    "logo": "/assets/logo.png",
    "established": "2026",
    "location": {
      "ar": "الكويت",
      "en": "Kuwait"
    },
    "about": {
      "title": {
        "ar": "أهلاً بكم في بيتكم الثاني..",
        "en": "Welcome to your second home.."
      },
      "story": {
        "ar": "من هنا، ومن قلب الكويت، نفتح لكم أبواباً تطل على أصالة أزقة البترون العريقة، لننقلكم في تجربة حسية فريدة تتجاوز حدود المكان؛ حيث تجتمع رائحة الياسمين مع عبق المطبخ اللبناني الأصيل. في ليالي البترون، نحن لا نقدم مجرد طعام، بل نحيي تراثاً عريقاً ونشارككم تفاصيله في كل طبق.",
        "en": "From the heart of Kuwait, we open doors overlooking the authenticity of the ancient alleys of Batroun, transporting you into a unique sensory experience. Where the scent of jasmine meets the fragrance of authentic Lebanese cuisine. We don't just serve food; we revive a rich heritage."
      },
      "slogan": {
        "ar": "لبناني على أصوله",
        "en": "Authentic Lebanese"
      }
    },
    "socialLinks": {
      "whatsapp": "",
      "instagram": "",
      "location": ""
    }
  },
